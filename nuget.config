<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>

  <!--
    SwissForge has no third-party dependencies and no PackageReference entries anywhere
    in the solution. The one package that must still resolve is NETStandard.Library:
    SwissForge.Core targets netstandard2.0 so the net48 add-in can consume it, and the
    SDK adds that package implicitly for netstandard2.0. It is a Microsoft targeting
    shim, not a dependency of ours.

    The source list used to be cleared outright, which meant a plain `dotnet restore`
    of the full solution could not succeed on any machine - only verify.sh worked,
    because SwissForgeVerifyOnly=true drops netstandard2.0. Source mapping restores the
    original intent instead: nothing but the targeting shim can be pulled from nuget.org,
    so an accidental PackageReference fails the restore rather than quietly acquiring a
    dependency.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="NETStandard.Library" />
      <package pattern="Microsoft.NETCore.Platforms" />
    </packageSource>
  </packageSourceMapping>
</configuration>
